{
  "name": "apertrove",
  "version": "0.10.3",
  "description": "Camera tethering, photo library and LAN remote for Canon EOS on Windows",
  "main": "electron/main.cjs",
  "author": "Apertrove contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win --dir",
    "test": "node --no-addons --max-old-space-size=192 --test tests/camera-control.test.cjs tests/camera-destinations.test.cjs tests/camera-discovery.test.cjs tests/capture-timing.test.cjs tests/equipment.test.cjs tests/focus-info.test.cjs tests/i18n.test.cjs tests/lighting-colors.test.cjs tests/native-focus.test.cjs tests/preset-series.test.cjs tests/remote-appearance.test.cjs tests/shutter-latch.test.cjs tests/workspace.test.cjs tests/native-production/live-histogram.cjs tests/native-production/h1-readonly.test.cjs tests/session-association.test.cjs tests/servo-focus.test.cjs tests/bulb-control.test.cjs tests/flash-bridge.test.cjs tests/live-orientation.test.cjs tests/servo-capture-admission.test.cjs tests/shutter-regression.test.cjs tests/canon-exposure-protocol.test.cjs tests/camera-accessory-support.test.cjs tests/accessory-integration.test.cjs tests/camera-accessory-capabilities.test.cjs tests/capture-delivery.test.cjs tests/capture-main-feedback.test.cjs tests/camera-card-actions.test.cjs tests/hold-controls.test.cjs tests/camera-card.test.cjs tests/camera-card-unknown.test.cjs",
    "test:t1": "node --no-addons --max-old-space-size=192 tests/t1-runner.cjs --tier T1 --scope synthetic tests/t1/library-schema.test.cjs tests/t1/library-bootstrap.test.cjs tests/t1/boot-state.test.cjs tests/t1/isolation.test.cjs",
    "preflight": "node scripts/preflight.cjs",
    "source:zip": "node scripts/source-zip.cjs",
    "i18n:check": "node scripts/check-i18n.cjs",
    "i18n:ui": "node tests/i18n-ui.cjs",
    "test:ui:prepare": "node --no-addons scripts/prepare-ui-runtime.cjs",
    "test:ui:controls": "node --no-addons --max-old-space-size=256 tests/product-controls-ui.cjs",
    "test:ui:holds": "node --no-addons tests/hold-desktop-ui.cjs",
    "test:ui:remote-holds": "node tests/hold-remote-ui.cjs",
    "test:ui:card": "node --no-addons tests/camera-card-integration-ui.cjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "chokidar": "^4.0.3",
    "exifr": "^7.1.3",
    "gsap": "3.15.1",
    "koffi": "^2.15.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.3.2",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "vite": "^6.4.6"
  },
  "build": {
    "appId": "app.apertrove.desktop",
    "productName": "Apertrove",
    "directories": {
      "output": "release"
    },
    "files": [
      "!**/*.map",
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "package.json",
      "README.md",
      "LICENSE",
      "README.ru.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md",
      "CHANGELOG.md",
      "docs/README.md",
      "docs/INSTALLATION.md",
      "docs/USER_GUIDE.md",
      "docs/STUDIO.ru.md",
      "docs/COMPATIBILITY.md",
      "docs/REQUIREMENTS.md",
      "docs/TROUBLESHOOTING.md",
      "docs/DEVELOPMENT.md",
      "docs/ARCHITECTURE.md",
      "docs/PRIVACY.md",
      "docs/RELEASE_NOTES.md",
      "docs/UI_SYMBOLS.md",
      "docs/localization.md",
      "docs/screenshots/**/*",
      "assets/THIRD_PARTY_LICENSES.txt",
      "!electron/flash-wia.ps1"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "electron/camera-worker.cjs",
      "electron/operation-lifecycle.cjs",
      "electron/transfer-context.cjs",
      "electron/transfer-producer.cjs",
      "electron/native-observations.cjs",
      "electron/sdk-initialization.cjs",
      "electron/sdk-environment.cjs",
      "electron/camera-capabilities.cjs",
      "electron/shot-inspector-worker.cjs",
      "electron/library.cjs",
      "electron/library-storage.cjs",
      "electron/library-text.cjs",
      "electron/library-recovery.cjs",
      "electron/library-schema.cjs",
      "electron/photo-name.cjs",
      "electron/metadata.cjs",
      "electron/camera-values.cjs",
      "electron/camera-control.cjs",
      "electron/native-buffer.cjs",
      "electron/camera-discovery.cjs",
      "electron/camera-destinations.cjs",
      "electron/focus-info.cjs",
      "electron/shutter-latch.cjs",
      "electron/shutter-diagnostics.cjs",
      "electron/capture-timing.cjs",
      "electron/image-quality.cjs",
      "electron/servo-focus.cjs",
      "electron/bulb-control.cjs",
      "electron/canon-exposure-protocol.cjs",
      "electron/camera-accessory-support.cjs",
      "electron/live-orientation.cjs",
      "electron/focus-hold.cjs",
      "electron/remote-holds.cjs",
      "electron/camera-card.cjs",
      "electron/camera-download.cjs"
    ],
    "extraFiles": [
      {
        "from": "assets/licenses",
        "to": "ThirdParty"
      }
    ],
    "win": {
      "target": "dir",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
